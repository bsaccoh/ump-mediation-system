[Unit]
Description=UMP Mediation API (Gunicorn)
After=network.target postgresql.service
Requires=postgresql.service
PartOf=mediation.target

[Service]
Type=notify
User=ump
Group=ump
WorkingDirectory=/opt/ump/mediation
EnvironmentFile=/opt/ump/.env
ExecStart=/opt/ump/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/opt/ump/gunicorn.sock \
    --workers 8 \
    --timeout 300 \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    --access-logfile /opt/ump/logs/gunicorn-access.log \
    --error-logfile /opt/ump/logs/gunicorn-error.log \
    --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mediation-api

[Install]
WantedBy=mediation.target
