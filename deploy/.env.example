# =============================================================================
# UMP Mediation System — Environment Variables
# =============================================================================
# Copy to /opt/ump/.env and fill in production values.
# All services read this file via EnvironmentFile= in their systemd units.
# =============================================================================

# ---- Django Core ----
DJANGO_SECRET_KEY=           # REQUIRED — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.5

# Set to False for LAN-only deployments without SSL certificate
SECURE_SSL_REDIRECT=False

# ---- Database (PostgreSQL) ----
DB_ENGINE=django.db.backends.postgresql
DB_USER=ump_user
DB_PASSWORD=                 # REQUIRED — PostgreSQL password for ump_user
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ump_mediation

# Per-operator databases (created automatically by settings.py)
# DB_NAME_MEDIATION_ORANGE=ump_mediation_orange
# DB_NAME_MEDIATION_AFRICELL=ump_mediation_africell

# ---- Multi-operator ----
OPERATORS=orange,africell,qcell,sierratel
DEFAULT_OPERATOR=orange

# ---- Service Mode ----
SERVICE_MODE=True
SERVICE_POLL_INTERVAL=10

# ---- CDR Processing ----
CDR_PERSIST_RECORDS=False
CDR_BATCH_SIZE=2000
CDR_MAX_RETRIES=3

# ---- Celery (optional — set USE_CELERY=True to enable) ----
USE_CELERY=False
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- Storage Paths ----
UMP_STORAGE_ROOT=/opt/ump/data
# Defaults derive from UMP_STORAGE_ROOT — override individually if needed:
# UMP_INPUT_ROOT=/opt/ump/data/landing/input
# UMP_OUTPUT_ROOT=/opt/ump/data/landing/output
# UMP_PROCESSING_ROOT=/opt/ump/data/processing
# UMP_ARCHIVE_ROOT=/opt/ump/data/archive
# UMP_ERROR_ROOT=/opt/ump/data/error
# UMP_QUARANTINE_ROOT=/opt/ump/data/quarantine

# ---- Logging ----
LOG_DIR=/opt/ump/logs
